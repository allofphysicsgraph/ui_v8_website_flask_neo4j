UNWIND [{id:"111355", properties:{name_latex:"LHS of expr 1 equals LHS of expr 2", assumptions_latex:"", number_of_outputs:1, number_of_inputs:2, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"LHS of Eq.~\ref{eq:#1} is equal to LHS of Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#3}."}}, {id:"111863", properties:{name_latex:"RHS of expr 1 equals RHS of expr 2", assumptions_latex:"", number_of_outputs:1, number_of_inputs:2, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"RHS of Eq.~\ref{eq:#1} is equal to RHS of Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#3}."}}, {id:"111469", properties:{name_latex:"X cross both sides by", assumptions_latex:"linear algebra", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Take cross product of $#1$ and Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#3}."}}, {id:"111145", properties:{name_latex:"X dot both sides", assumptions_latex:"linear algebra", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Take inner product of $#1$ with Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#3}."}}, {id:"111530", properties:{name_latex:"add X to both sides", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Add $#1$ to both sides of Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#3}."}}, {id:"111980", properties:{name_latex:"add expr 1 to expr 2", assumptions_latex:"", number_of_outputs:1, number_of_inputs:2, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Add Eq.~\ref{eq:#1} to Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#2}."}}, {id:"111242", properties:{name_latex:"add zero to LHS", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Add zero to LHS of Eq.~\ref{eq:#2}, where $0=#1$; yields Eq.~\ref{eq:#3}."}}, {id:"111717", properties:{name_latex:"add zero to RHS", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Add zero to RHS of Eq.~\ref{eq:#2}, where $0=#1$; yields Eq.~\ref{eq:#3}."}}, {id:"111463", properties:{name_latex:"apply divergence", assumptions_latex:"multi-variable calculus", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Apply divergence to both sides of Eq.~\ref{eq:#1}; yields Eq.~\ref{eq:#2}."}}, {id:"111490", properties:{name_latex:"apply function to both sides of expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:2, notes_latex:"Example: apply sin(x) to 'a = b + c'", latex:"Apply function $#1$ with argument $#2$ to Eq.~\ref{eq:#3}; yields Eq.~\ref{eq:#4}"}}, {id:"111531", properties:{name_latex:"apply gradient to scalar function", assumptions_latex:"multi-variable calculus", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Apply gradient to both sides of Eq.~\ref{eq:#1}; yields Eq.~\ref{eq:#2}."}}, {id:"111390", properties:{name_latex:"apply operator to bra", assumptions_latex:"quantum: Dirac notation", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Apply operator in Eq.~\ref{eq:#1} to bra; yields Eq.~\ref{eq:#2}."}}, {id:"111946", properties:{name_latex:"apply operator to ket", assumptions_latex:"quantum: Dirac notation", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Apply operator in Eq.~\ref{eq:#1} to ket; yields Eq.~\ref{eq:#2}."}}, {id:"111791", properties:{name_latex:"assume N dimensions", assumptions_latex:"", number_of_outputs:1, number_of_inputs:0, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Assume $#1$ dimensions; decompose vector to be Eq.~\ref{eq:#2}."}}, {id:"111368", properties:{name_latex:"both sides cross X", assumptions_latex:"linear algebra", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Take cross product of Eq.~\ref{eq:#2} and $#1$; yields Eq.~\ref{eq:#3}"}}, {id:"111567", properties:{name_latex:"both sides dot X", assumptions_latex:"linear algebra", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Take inner product of Eq.~\ref{eq:#2} with $#1$; yields Eq.~\ref{eq:#3}"}}, {id:"111278", properties:{name_latex:"boundary condition", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Boundary condition: Eq.~\ref{eq:#2} when Eq.~\ref{eq#1}."}}, {id:"111802", properties:{name_latex:"boundary condition for expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"A boundary condition for Eq.~\ref{eq:#1} is Eq.~\ref{eq:#2}"}}, {id:"111410", properties:{name_latex:"change five variables in expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:10, notes_latex:"", latex:"Change of variable $#1$ to $#2$ and $#3$ to $#4$ and $#5$ to $#6$ and $#7$ to $#8$ and $#9$ to $#10$ in Eq.~\ref{eq:#11}; yields Eq.~\ref{eq:#12}."}}, {id:"111777", properties:{name_latex:"change four variables in expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:8, notes_latex:"", latex:"Change of variable $#1$ to $#2$ and $#3$ to $#4$ and $#5$ to $#6$ and $#7$ to $#8$ in Eq.~\ref{eq:#9}; yields Eq.~\ref{eq:#10}."}}] AS row
CREATE (n:inference_rule{id: row.id}) SET n += row.properties;
UNWIND [{id:"111471", properties:{name_latex:"change six variables in expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:12, notes_latex:"", latex:"Change of variable $#1$ to $#2$ and $#3$ to $#4$ and $#5$ to $#6$ and $#7$ to $#8$ and $#9$ to $#10$ and $#11$ to $#12$ in Eq.~\ref{eq:#13}; yields Eq.~\ref{eq:#14}."}}, {id:"111236", properties:{name_latex:"change three variables in expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:6, notes_latex:"", latex:"Change of variable $#1$ to $#2$ and $#3$ to $#4$ and $#5$ to $#6$ in Eq.~\ref{eq:#7}; yields Eq.~\ref{eq:#8}."}}, {id:"111984", properties:{name_latex:"change two variables in expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:4, notes_latex:"", latex:"Change variable $#1$ to $#2$ and $#3$ to $#4$ in Eq.~\ref{eq:#5}; yields Eq.~\ref{eq:#6}."}}, {id:"111886", properties:{name_latex:"change variable X to Y", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:2, notes_latex:"", latex:"Change variable $#1$ to $#2$ in Eq.~\ref{eq:#3}; yields Eq.~\ref{eq:#4}."}}, {id:"111345", properties:{name_latex:"claim LHS equals RHS", assumptions_latex:"", number_of_outputs:0, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Thus we see that LHS of Eq.~\ref{eq:#1} is equal to RHS."}}, {id:"111550", properties:{name_latex:"claim expr 1 equals expr 2", assumptions_latex:"", number_of_outputs:0, number_of_inputs:2, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Thus we see that Eq.~\ref{eq:#1} is equivalent to Eq.~\ref{eq:#2}."}}, {id:"111728", properties:{name_latex:"combine like terms", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Combine like terms in Eq.~\ref{eq:#1}; yields Eq.~\ref{eq:#2}."}}, {id:"111484", properties:{name_latex:"conjugate both sides", assumptions_latex:"complex values", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Conjugate both sides of Eq.~\ref{eq:#1}; yields Eq.~\ref{eq:#2}."}}, {id:"111996", properties:{name_latex:"conjugate function X", assumptions_latex:"complex values", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Conjugate $#1$ in Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#3}."}}, {id:"111696", properties:{name_latex:"conjugate transpose both sides", assumptions_latex:"complex valued linear algebra", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Conjugate transpose of both sides of Eq.~\ref{eq:#1}; yields Eq.~\ref{eq:#2}."}}, {id:"111104", properties:{name_latex:"declare assumption", assumptions_latex:"", number_of_outputs:1, number_of_inputs:0, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Eq.~\ref{eq:#1} is an assumption."}}, {id:"111341", properties:{name_latex:"declare final expression", assumptions_latex:"", number_of_outputs:0, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Eq.~\ref{eq:#1} is one of the final equations."}}, {id:"111237", properties:{name_latex:"declare guess solution", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"https://en.wikipedia.org/wiki/Ansatz", latex:"Judicious choice as a guessed solution to Eq.~\ref{eq:#1} is Eq.~\ref{eq:#2},"}}, {id:"111299", properties:{name_latex:"declare identity", assumptions_latex:"", number_of_outputs:1, number_of_inputs:0, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Eq.~\ref{eq:#1} is an identity."}}, {id:"111981", properties:{name_latex:"declare initial expression", assumptions_latex:"", number_of_outputs:1, number_of_inputs:0, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Eq.~\ref{eq:#1} is an initial equation."}}, {id:"111649", properties:{name_latex:"differentiate with respect to", assumptions_latex:"differential equations", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Differentiate Eq.~\ref{eq:#2} with respect to $#1$; yields Eq.~\ref{eq:#3}."}}, {id:"111474", properties:{name_latex:"distribute conjugate to factors", assumptions_latex:"complex values", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Distribute conjugate to factors in Eq.~\ref{eq:#1}; yields Eq.~\ref{eq:#2}."}}, {id:"111890", properties:{name_latex:"distribute conjugate transpose to factors", assumptions_latex:"complex valued linear algebra", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Distribute conjugate transpose to factors in Eq.~\ref{eq:#1}; yields Eq.~\ref{eq:#2}."}}, {id:"111975", properties:{name_latex:"divide both sides by", assumptions_latex:"", number_of_outputs:1, number_of_inputs:1, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:1, notes_latex:"", latex:"Divide both sides of Eq.~\ref{eq:#2} by $#1$; yields Eq.~\ref{eq:#3}."}}, {id:"111421", properties:{name_latex:"divide expr 1 by expr 2", assumptions_latex:"", number_of_outputs:1, number_of_inputs:2, author_name_latex:"ben.is.located@gmail.com", number_of_feeds:0, notes_latex:"", latex:"Divide Eq.~\ref{eq:#1} by Eq.~\ref{eq:#2}; yields Eq.~\ref{eq:#3}."}}] AS row
