#!/usr/bin/env python3

# The gunicorn.conf.py file is the default configuration file for Gunicorn, 
# and it is automatically loaded if it exists in the current working directory where you execute Gunicorn.

# This file is only relevant if coverage.py is being used.
# Then you also need to adjust `compose.yaml`

import os
import coverage


def post_fork(server, worker):
    server.log.info("Worker spawned: Starting coverage collection...")
    # Initialize coverage pointing to our config file
    cov = coverage.Coverage(config_file=".coveragerc")
    cov.start()
    # Store the coverage instance on the worker to access it on exit
    worker.cov = cov


def worker_exit(server, worker):
    server.log.info("Worker exiting: Saving coverage collection...")
    if hasattr(worker, "cov"):
        worker.cov.stop()
        worker.cov.save()
